# Copy to .env (same folder) and fill in ONE option. Leave everything empty to use your Claude Code login session.
# Variables already set in your shell take precedence over this file.

# Option 1: your own Anthropic API key (billed to your Console account)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Option 2: an Anthropic-compatible API such as DeepSeek
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_API_KEY=<your DeepSeek API key>
# ANTHROPIC_MODEL=deepseek-flash

# Option 3: a gateway that expects a bearer token instead of an x-api-key header
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=<token>
